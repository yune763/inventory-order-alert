# ローカルで動かすだけなら、このファイルは要らない。
# npm run dev だけで webapp/.pglite/ にローカルDB（Postgres本体のWASM版）が作られる。

# ── 外部のPostgresを使うとき（任意）──────────────────────────
# Supabase なら Project Settings → Database → Connection string（URI）。
# 設定するとローカルDBではなくそちらを見る。テーブルは
#   DATABASE_URL="..." node scripts/db.mjs migrate
# で作る。
# DATABASE_URL=postgresql://postgres:****@db.xxxxxxxx.supabase.co:5432/postgres

# ── 公開URL（任意）────────────────────────────────────────────
# 日次アラートの本文に載せるリンク先。未設定ならリクエストのオリジンを使う。
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── 日次アラート（任意）───────────────────────────────────────
# /api/alerts/daily の入口の鍵。設定しない限りこの入口は 503 を返す。
# cron から  GET /api/alerts/daily?token=...&send=1  のように叩く。
ALERT_API_TOKEN=

# メールで飛ばすときだけ。3つ揃っていないと本文を返すだけで送信しない。
RESEND_API_KEY=
ALERT_MAIL_TO=
ALERT_MAIL_FROM=
